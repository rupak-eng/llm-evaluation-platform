# Copy to .env and fill in. Nothing here is committed.
# Database: Postgres is the production path. SQLite is the local/test fallback.
# Local dev uses the shared portfolio Postgres; our tables live in the llmeval
# schema so we never clash with sibling projects. The password below is a
# placeholder — the real dev password is never committed or logged.
DATABASE_URL=postgresql+psycopg2://portfolio:<dev-password>@127.0.0.1:5432/portfolio
LLMEVAL_DB_SCHEMA=llmeval
# Example dedicated Postgres: postgresql+psycopg2://llmeval:llmeval@localhost:5432/llmeval

# LLM judge provider (OpenAI-compatible). Leave empty to use the deterministic stub judge.
JUDGE_PROVIDER=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Eval behaviour
EVAL_SEED=42
REGRESSION_MAX_DROP=0.15
REGRESSION_MIN_KAPPA=0.40
